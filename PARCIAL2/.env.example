# ---------------------------------------------------------------------------
# Configuración del servidor
# ---------------------------------------------------------------------------
PUERTO=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Conexión a PostgreSQL (contenedor Docker definido en docker-compose.yml)
# ---------------------------------------------------------------------------
# El contenedor publica el puerto 5432. Si en tu PC ese puerto ya está ocupado,
# cambiá BD_PORT (por ejemplo 5433); docker-compose usa este mismo valor.
BD_HOST=localhost
BD_PORT=5432
BD_USER=postgres
BD_PASS=postgres
BD_BD=parcial2_aw2

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Clave privada usada para firmar los JWT. Debe ser larga y aleatoria.
CLAVE_PRIVADA=cambia-esta-clave-privada-por-una-larga-y-aleatoria
# Clave usada por cookie-parser para firmar la cookie (signed: true).
# Puede ser distinta de CLAVE_PRIVADA.
CLAVE_COOKIE=cambia-esta-clave-de-cookie-por-una-larga-y-aleatoria
# Tiempo de vida del JWT (y de la cookie) expresado en segundos.
JWT_EXPIRACION_SEGUNDOS=3600
# Nombre de la cookie httpOnly que transporta el token.
NOMBRE_COOKIE=token_acceso
