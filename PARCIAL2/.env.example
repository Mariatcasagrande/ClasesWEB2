# ---------------------------------------------------------------------------
# Configuración del servidor
# ---------------------------------------------------------------------------
PUERTO=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Conexión a PostgreSQL
# ---------------------------------------------------------------------------
# El contenedor publica el puerto 5432. 
BD_HOST=localhost
BD_PORT=5432
BD_USER=postgres
BD_PASS=postgres
BD_BD=parcial2_aw2

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Clave privada usada para firmar los JWT. 
CLAVE_PRIVADA=cambia-esta-clave-privada-por-una-larga-y-aleatoria
# Clave usada por cookie-parser para firmar la cookie .
CLAVE_COOKIE=cambia-esta-clave-de-cookie-por-una-larga-y-aleatoria
# Nombre de la cookie httpOnly que transporta el token.
NOMBRE_COOKIE=token_acceso
